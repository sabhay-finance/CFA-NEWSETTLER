# Substack Session Cookie
# How to get it:
# 1. Log in to https://sabhay1.substack.com in your browser
# 2. Open Developer Tools (F12 or Cmd+Opt+I) -> Application / Storage -> Cookies -> https://substack.com
# 3. Copy the value of 'substack.sid' (or 'connect.sid') and paste it below:
SUBSTACK_SID=your_substack_sid_cookie_here

# Substack Publication Settings
SUBSTACK_SUBDOMAIN=sabhay1
SUBSTACK_USER_ID=553067075
SUBSTACK_PUB_ID=11293558

# Set to 'true' if you want each post to be emailed to subscribers (default is 'false' - web post only)
SUBSTACK_SEND_EMAIL=false
